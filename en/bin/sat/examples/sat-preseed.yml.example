# ~/.config/sat/sat-preseed.yml
# Generated by sat init. Owned by SAT operator.
# SAT Tools: https://github.com/steelcj/sat-tools

sat:
  # version managed in VERSION file at repository root
  version: 0.4.0
  language: en
  caches:
    iana_registry:
      path: ~/.config/sat/cache/iana-registry.txt
      staleness_days: 30

sat_collection:
  path: ~/.local/share/sat-tool/0.4.0
  archives:
    en:
      path: ~/.local/share/sat-tool/0.4.0/en

collections:
  default_parent: ~/projects/sat
  chrissteel.com:
    path: ~/projects/sat/chrissteel.com
    archives:
      en-ca:
        path: ~/projects/sat/chrissteel.com/en-ca
      fr-ca:
        path: ~/projects/sat/chrissteel.com/fr-ca
